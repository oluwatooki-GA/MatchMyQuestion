# Environment variables template
# Copy to .env.dev or .env.prod and fill in values
VITE_API_URL=http://localhost:8000
# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=questions

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# CORS
CORS_ORIGIN=http://localhost:3000
# Or a full URL (e.g. Render Key Value internal URL); overrides REDIS_HOST/PORT
# REDIS_URL=redis://red-xxxx:6379

# Embedding model (must match the one the scraper used to build the collection)
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
